<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / transfer rules for Android 12 (API 31) and later; `backup_rules.xml` still covers
    older releases through android:fullBackupContent.

    References are snapshots of a *specific device's* battery counters, so restoring them onto
    another device would produce nonsense deltas. Cloud backup therefore keeps the settings only,
    while a direct device-to-device transfer — same user, new phone — keeps nothing, since the
    counters it would be compared against start from zero anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
