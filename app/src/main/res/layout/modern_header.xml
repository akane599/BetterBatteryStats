<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/modern_period" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" />
    <TextView android:id="@+id/modern_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge" android:lineSpacingExtra="5dp" />
    <TextView android:id="@+id/modern_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/modern_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp"
        android:indeterminate="true" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/modern_refresh"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/modern_refresh" />
    <com.google.android.material.button.MaterialButton android:id="@+id/modern_connect"
        style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/modern_connect" />
    <TextView android:id="@+id/modern_explanation" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
